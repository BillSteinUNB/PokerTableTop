# Optional. Copy to .env in the project root. Defaults work with npm run dev.
PORT=3001
# Keep unset for development; set production on a deployed server.
# NODE_ENV=production

# Needed only for a separate frontend or a reverse proxy rewriting Host.
# CLIENT_URL=https://poker.example.com

# Local development uses .data/rooms.json automatically.
# DATABASE_URL takes priority over file storage; use a development database here.
# DATABASE_URL=postgresql://user:password@localhost:5432/poker
# For production without a database, put this file on persistent storage.
# POKER_DATA_FILE=/data/pixel-poker/rooms.json

# Build-time client setting. Normally leave unset (same-origin requests).
# VITE_SERVER_URL=https://poker-api.example.com
