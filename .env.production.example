# Enter these in Northflank's runtime environment, not Vercel.
NODE_ENV=production
PORT=3001
CLIENT_URL=https://your-project.vercel.app
# Link the PostgreSQL addon's internal POSTGRES_URI secret as DATABASE_URL.
# Enable TLS on the addon. Use the direct primary URI, not a pooled URI.
# DATABASE_URL=<linked Northflank secret>
PGSSLMODE=verify-full

# Enter this public URL in Vercel's Production environment, then rebuild.
# VITE_SERVER_URL=https://your-game-server.code.run

# File-based hosting alternative only (unused when DATABASE_URL is set):
# POKER_DATA_FILE=/app/.data/rooms.json
