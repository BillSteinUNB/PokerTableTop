{
  "name": "pixel-poker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src shared server scripts tests",
    "check": "npm run lint && npm test && npm run build",
    "format": "prettier --write src shared server scripts tests *.js *.json *.html *.md"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "vite": "^7.2.0"
  }
}
